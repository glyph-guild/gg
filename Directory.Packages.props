<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Rocks" Version="10.2.0" />
    <PackageVersion Include="Terminal.Gui" Version="2.4.17" />

    <!-- A FORK, AND IT EXISTS TO BE DELETED. Upstream SIPSorcery does not work
         under Native AOT: the SCTP state cookie is reflection-serialised, the
         trimmer removes its members, and the association stalls in CookieEchoed
         so data channels never open. gg publishes Native AOT.

           fix:   https://github.com/sipsorcery-org/sipsorcery/pull/1817
           issue: https://github.com/sipsorcery-org/sipsorcery/issues/1816

         The -gg suffix is load-bearing twice over: it says out loud that this is
         not upstream, and SemVer sorts a prerelease BELOW its release, so this
         build can never win a version range against a real 10.0.16.

         To leave: pin the upstream version that contains the fix, delete
         nuget.config's sipsorcery-fork source and scripts/fetch-sipsorcery.sh.
         TheForkIsTemporaryTests fails until the first of those is true. -->
    <PackageVersion Include="SIPSorcery" Version="10.0.16-gg.1" />
    <!-- Hosting a child in a pseudo-terminal so gg can keep a bar on screen.
         Both are net10.0 and actively published; the better-known Pty.Net and
         XtermSharp are unlisted on nuget.org, netstandard2.0, and XtermSharp
         depends on NStack.Core - Terminal.Gui v1's string library. -->
    <PackageVersion Include="Porta.Pty" Version="2.2.2" />
    <PackageVersion Include="XTerm.NET" Version="2.0.2" />
    <PackageVersion Include="TUnit" Version="1.63.25" />
    <!-- The only YAML parser in the product, and it lives in gg alone.
         Verified under Native AOT by inspecting the package rather than
         trusting the version: of 432 types exactly two carry
         [RequiresDynamicCode] - DeserializerBuilder and SerializerBuilder -
         and neither is used. The event-level parser carries no annotations
         and publishes AOT with no IL warnings. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
      <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
  </ItemGroup>
</Project>
