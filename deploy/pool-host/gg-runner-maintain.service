# The resident runner, as a service rather than a terminal somebody left open.
#
# It does NOT start until a person has signed in on this machine. That is
# deliberate: `gg runner maintain` refuses without a session, and its own words
# are "Registering a runner is a person's action". A pool host is provisioned
# once by a person; it is not a thing that scales itself up.
[Unit]
Description=Good Grief resident runner (pool maintenance)
After=docker.service
Requires=docker.service

[Service]
User=gg
# THE PROXY, NEVER THE SOCKET. Unset is refused loudly by the runner itself;
# what nothing else refuses is a value naming the socket, so it is written
# here once, correctly, and PoolHostTests holds it that way.
Environment=GG_POOL_ENDPOINT=http://127.0.0.1:23750
# WHICH CONTROL PLANE. Left unset, gg falls back to http://localhost:5199 -
# the right default on a laptop, and on a pool host it means the machine
# answers to itself while looking configured. Nothing refuses that, which is
# why it is written here rather than left to a fallback.
Environment=GG_CONTROL_PLANE=https://CHANGEME.example
# The pool this host maintains. Every pool carries the reserved prefix,
# because the proxy allows creating a member only under it - see PoolNaming.
Environment=GG_POOL=gg-pool-CHANGEME
# AN ABSOLUTE PATH THE RUNNER CANNOT WRITE, and after the move to a .NET tool
# that is a property rather than an accident. /usr/local/bin/gg is a root-owned
# symlink to a root-owned /usr/local/lib/gg/gg, put there by a --tool-path
# install. `dotnet tool install -g` would have placed the same shim inside
# $HOME/.dotnet/tools of whoever ran it - and this unit runs as User=gg, so the
# process the OS is holding apart from the console could have replaced what the
# OS starts. PoolHostTests holds this line to a path outside that home.
#
# The shim is IL and finds the runtime itself: cloud-init installs .NET at
# /usr/share/dotnet, which is the default probe location on Linux, so no
# DOTNET_ROOT is set here. If that ever moves, this unit fails at start saying
# so - which is the loud kind of wrong, and the reason it is not written twice.
ExecStart=/usr/local/bin/gg runner maintain ${GG_POOL}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
