<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />

    <!-- The patched SIPSorcery build, fetched into ./packages by
         scripts/fetch-sipsorcery.sh. Upstream does not work under Native AOT -
         see that script, and sipsorcery-org/sipsorcery#1817 - and gg publishes
         Native AOT.

         A local folder rather than a feed, because the package comes from a
         public repo's RELEASE ASSET and downloads with no authentication. The
         alternative, GitHub Packages, is repository-scoped and would need a
         credential this repo has no business holding. -->
    <add key="sipsorcery-fork" value="./packages" />

    <!-- Where CI packs the tool before installing it the way a person would.
         Declared here rather than passed on the command line, because NuGet
         refuses that flag outright once source mapping is on, which is how
         this arrived: adding the mapping above broke the tool job, and only
         the tool job, because it is the one place a package is installed
         rather than restored. The directory does not exist outside CI and
         nothing references this id, so it is inert everywhere else. -->
    <add key="artifacts" value="./artifacts" />
  </packageSources>

  <!-- SCOPED TO ONE PACKAGE, so the folder cannot start answering for anything
       else. Without a mapping a local directory is a source for every id in it,
       and a stray .nupkg would silently shadow nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="sipsorcery-fork">
      <package pattern="SIPSorcery" />
    </packageSource>
    <packageSource key="artifacts">
      <package pattern="GlyphGuild.Gg.Cli" />
    </packageSource>
  </packageSourceMapping>
</configuration>
