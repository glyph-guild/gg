<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The contract versions ITSELF, independently of the gg binary.
         Declared by hand and held to account by ContractSurfaceTests: a
         fingerprint of the wire surface is recorded against each version in
         contract-versions.json, and changing the surface without moving this
         number fails the build.

         It used to be 0.1.0-alpha.N where N was the commit count on main, so a
         README fix bumped the wire contract exactly as much as a new message
         type did. A consumer seeing the number move learned nothing.

         Pre-1.0: any wire change is a minor bump, and there is no compatibility
         promise. GgVersions.Protocol is a different number and moves only when
         the protocol itself becomes incompatible. -->
    <Version>0.13.0</Version>

    <!-- PINNED, and it must stay pinned at this number.

         Both fingerprints - the wire surface and the fact vocabulary - walk
         property types and record Type.FullName. For a constructed generic
         like IReadOnlyList<LockHash> that string embeds the ASSEMBLY-QUALIFIED
         name of the argument, which contains Version=x.y.z.0. So the assembly
         version leaked into every fingerprint, and bumping <Version> made both
         ledgers report "the surface changed" when nothing about the surface
         had.

         That is the worst possible false alarm for this mechanism: it fires on
         the exact action a real change also requires, so it trains whoever
         sees it to re-record the hash without reading the diff - which is the
         one thing the ledger exists to prevent.

         Pinning it here fixes the leak WITHOUT rewriting history. Every
         recorded surface in contract-versions.json and fact-vocabulary.json
         was computed under 0.10.0.0, so they all stay valid, and from now on
         the package version moves without disturbing them. Changing this
         number would invalidate all of them at once. -->
    <AssemblyVersion>0.10.0.0</AssemblyVersion>
    <IsPackable>true</IsPackable>
    <PackageId>GlyphGuild.Gg.Contracts</PackageId>
    <Description>Wire protocol contracts for Good Grief (gg): console, runner, control plane.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
